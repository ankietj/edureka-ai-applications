# Groq API Key (obtain from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Text Model Name
MODEL_NAME=llama-3.3-70b-versatile

# Environment mode
ENVIRONMENT=development

# Groq Vision-capable Model Name (e.g. meta-llama/llama-4-scout-17b-16e-instruct or llama-3.2-11b-vision-preview)
VISION_MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: set to true if you want Gradio to generate a public share URL (default: false for local classroom use)
GRADIO_SHARE=false
